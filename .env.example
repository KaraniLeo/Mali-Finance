# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# =========================================================================
# PAYSTACK PAYMENT GATEWAY (Settling into Safaricom M-Pesa Paybill)
# Get keys from: https://dashboard.paystack.com/#/settings/developer
# In Paystack Settings > Payouts: set destination to your Safaricom M-Pesa Paybill Number
# =========================================================================
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# =========================================================================
# SMS CARRIER GATEWAY (Multi-Carrier OTP: Safaricom, Airtel, Telkom)
# Africa's Talking (Kenya gold standard): https://africastalking.com
# Use username="sandbox" and test API key for free sandbox testing
# =========================================================================
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY="your_africastalking_api_key"
AFRICASTALKING_SENDER_ID="UTAJIRI"

# Fallback SMS Gateway: Twilio (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# Cryptographic Salt for OTP Hashing (Prevents plaintext OTP storage)
OTP_SALT="utajiri-production-secure-salt-2026"

# =========================================================================
# GOOGLE PLAY STORE BILLING COMPLIANCE
# Google Cloud Service Account with Android Publisher API access
# =========================================================================
GOOGLE_PLAY_PACKAGE_NAME="com.utajiri.finance"
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=""
